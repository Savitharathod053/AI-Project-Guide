# Projexa Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Flask Secret Key
SECRET_KEY=projexa-super-secret-key-change-in-production-2026

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///projexa.db
# DATABASE_URL=postgresql://user:password@localhost:5432/projexa_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1

# Google Gemini API Key (Required for AI task mentor & Innovation/Uniqueness Analyzer)
# Get your free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

