# ProjectGuard Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Flask Secret Key
SECRET_KEY=projectguard-super-secret-key-change-in-production-2026

# Database Configuration (SQLite default for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///projectguard.db
# DATABASE_URL=postgresql://user:password@localhost:5432/projectguard_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
